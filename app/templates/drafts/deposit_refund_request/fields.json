{
  "id": "deposit_refund_request",
  "title": "Request to refund a security deposit",
  "description": "Asks the owner to refund the deposit after you have moved out.",
  "doc_types": ["rental_leave_licence"],
  "wording_field": "additional_points",
  "required_slots": ["deposit_amount"],
  "fields": [
    {"name": "sender_name", "type": "text", "required": true, "max_length": 120,
     "labels": {"en": "Your full name", "hi": "आपका पूरा नाम", "mr": "तुमचे पूर्ण नाव"},
     "help": {"en": "As it appears on the agreement.", "hi": "जैसा अनुबंध में लिखा है।", "mr": "करारात लिहिल्याप्रमाणे."}},
    {"name": "sender_address", "type": "address", "required": true, "max_length": 300,
     "labels": {"en": "Your current address", "hi": "आपका वर्तमान पता", "mr": "तुमचा सध्याचा पत्ता"}},
    {"name": "sender_email", "type": "email", "required": false, "max_length": 120,
     "labels": {"en": "Your email address", "hi": "आपका ईमेल पता", "mr": "तुमचा ईमेल पत्ता"}},
    {"name": "recipient_name", "type": "text", "required": true, "max_length": 120, "prefill_from": "party.other",
     "labels": {"en": "Owner's name", "hi": "मालिक का नाम", "mr": "मालकाचे नाव"}},
    {"name": "recipient_address", "type": "address", "required": true, "max_length": 300,
     "labels": {"en": "Owner's address", "hi": "मालिक का पता", "mr": "मालकाचा पत्ता"}},
    {"name": "premises", "type": "text", "required": true, "max_length": 300, "prefill_from": "key_term.premises",
     "labels": {"en": "The premises", "hi": "परिसर", "mr": "जागा"}},
    {"name": "agreement_date", "type": "date", "required": true,
     "labels": {"en": "Date of the agreement", "hi": "अनुबंध की तिथि", "mr": "कराराची तारीख"}},
    {"name": "deposit_amount", "type": "money", "required": true, "max_length": 20, "prefill_from": "key_term.deposit",
     "labels": {"en": "Deposit amount", "hi": "जमा राशि", "mr": "अनामत रक्कम"},
     "help": {"en": "In digits, as stated in the agreement.", "hi": "अंकों में, जैसा अनुबंध में है।", "mr": "आकड्यांत, करारात दिल्याप्रमाणे."}},
    {"name": "move_out_date", "type": "date", "required": true,
     "labels": {"en": "Date you handed back the keys", "hi": "चाबी लौटाने की तिथि", "mr": "किल्ल्या परत दिल्याची तारीख"}},
    {"name": "bank_details", "type": "text", "required": false, "max_length": 200,
     "labels": {"en": "Where to send the refund", "hi": "धनवापसी कहाँ भेजें", "mr": "परतावा कुठे पाठवावा"},
     "help": {"en": "Account name and number, or UPI id.", "hi": "खाता नाम और नंबर, या UPI आईडी।", "mr": "खाते नाव व क्रमांक, किंवा UPI आयडी."}},
    {"name": "additional_points", "type": "multiline", "required": false, "max_length": 1200,
     "labels": {"en": "Anything else you want to say", "hi": "और कुछ जो आप कहना चाहते हैं", "mr": "आणखी काही सांगायचे असल्यास"}},
    {"name": "reply_days", "type": "choice", "required": true, "choices": ["7", "15", "30"],
     "labels": {"en": "Days you are allowing for a reply", "hi": "उत्तर के लिए दिन", "mr": "उत्तरासाठी दिवस"}}
  ]
}

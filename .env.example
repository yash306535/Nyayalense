# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Every variable is optional: with none of them set, the app runs offline in
# demo mode against the deterministic fake provider.

# ---------------------------------------------------------------- model provider
# 'gemini' for the real API, 'fake' for the offline demo provider.
LLM_PROVIDER=fake

# An AI Studio key. Use this for local development.
GEMINI_API_KEY=

# For production, prefer Vertex AI with the Cloud Run service account, so no
# API key exists anywhere. Set these three instead of GEMINI_API_KEY.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1

# Main model for analysis and Q&A, and the cheap model used only to break a tie
# on document type. Switching model is an env-var change, nothing more.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_LITE=gemini-3.1-flash-lite

# Reasoning effort for extraction: none | low | medium | high.
GEMINI_THINKING_LEVEL=low

# ---------------------------------------------------------------- optional Google services
# Each is off by default and has a working fallback, so the app never depends on
# one being enabled.

# Sensitive Data Protection for masking. The regex masker always runs regardless.
ENABLE_DLP=false

# Document AI for OCR of scans. Falls back to Gemini transcription.
ENABLE_DOCUMENT_AI=false
DOCUMENT_AI_PROCESSOR=

# Cloud Text-to-Speech for read-aloud. Falls back to the browser's own voice.
ENABLE_TTS=false

# An independent grounding score per statement, on top of the verifier.
ENABLE_CHECK_GROUNDING=false
GROUNDING_MIN_SUPPORT=0.6

# ---------------------------------------------------------------- verification and drafting
# Minimum rapidfuzz partial ratio, 50-100, for a quote to count as verified.
# Higher is stricter. Lowering this weakens the core guarantee.
QUOTE_MATCH_THRESHOLD=92

# Offer model-suggested wording for free-text letter fields. The wording may
# only refer to facts through slot tokens; code fills them in.
ENABLE_AI_WORDING=true

# ---------------------------------------------------------------- exports and law data
PDF_VARIANT=pdf/ua-1
EXPORT_TIMEOUT_SECONDS=20
EXPORT_WARMUP=false

# Show law rows still marked 'extracted', labelled "Not yet reviewed" in the UI.
# Keep this false in production until the rows have been checked against the
# official PDFs. See docs/DATA.md.
LAW_DATA_SHOW_UNREVIEWED=false

# ---------------------------------------------------------------- limits
MAX_UPLOAD_MB=10
MAX_PAGES=60
MAX_DOCUMENT_CHARS=400000
MAX_CLAUSES=1500
RATE_LIMIT_PER_MINUTE=30
EXPORT_RATE_LIMIT_PER_MINUTE=10
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENCY=8

# ---------------------------------------------------------------- cache and logs
CACHE_TTL_SECONDS=1800
CACHE_MAX_ITEMS=256
LOG_LEVEL=INFO
